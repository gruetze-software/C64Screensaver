<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <NativeLib>Shared</NativeLib>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <Compile Include="../../C64Screensaver/BasicMachine.cs" Link="Shared/BasicMachine.cs" />
    <Compile Include="../../C64Screensaver/BasicPrograms.cs" Link="Shared/BasicPrograms.cs" />
    <Compile Include="../../C64Screensaver/ScreenSession.cs" Link="Shared/ScreenSession.cs" />
    <Compile Include="../../C64Screensaver/PixelCharacters.cs" Link="Shared/PixelCharacters.cs" />
    <EmbeddedResource Include="../../C64Screensaver/Assets/Kickstart/*.gif" LogicalName="GruetzeRetroSaver.Kickstart.%(Filename)%(Extension)" />
    <Compile Include="../../C64Screensaver/KickstartFrames.cs" Link="Shared/KickstartFrames.cs" />
    <Compile Include="../../C64Screensaver/AmigaFrameBuffer.cs" Link="Shared/AmigaFrameBuffer.cs" />
    <Compile Include="../../C64Screensaver/SaverSettings.cs" Link="Shared/SaverSettings.cs" />
    <Compile Include="../../C64Screensaver/C64FrameBuffer.cs" Link="Shared/C64FrameBuffer.cs" />
    <Compile Include="../../C64Screensaver/CpuCrtRenderer.cs" Link="Shared/CpuCrtRenderer.cs" />
    <Compile Include="../../C64Screensaver/CrtRenderer.cs" Link="Shared/CrtRenderer.cs" />
    <Compile Include="../../C64Screensaver/CrtPowerRenderer.cs" Link="Shared/CrtPowerRenderer.cs" />
  </ItemGroup>
</Project>
