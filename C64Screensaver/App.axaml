<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="C64Screensaver.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#216F69"/>
                <ColorPaletteResources x:Key="Dark" Accent="#68CBBE"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="/Styles/Dialogs.axaml"/>
    </Application.Styles>
</Application>
