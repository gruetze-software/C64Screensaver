<Window xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="using:C64Screensaver.Controls" xmlns:local="using:C64Screensaver"
 x:Class="C64Screensaver.SettingsWindow" Classes="dialog"
 Title="Gruetze RetroSaver · Settings" Icon="/Assets/app-icon.ico"
 Width="1080" Height="740" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen">
 <Grid RowDefinitions="Auto,*,Auto" Margin="24">
  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
   <StackPanel Spacing="5">
    <TextBlock Text="Monitor effects" FontSize="25" FontWeight="SemiBold"/>
    <TextBlock Text="Your C64. Your Amiga. Your monitor." Classes="hint"/>
   </StackPanel>
   <Image Name="LogoImage" Grid.Column="1" Width="56" Height="56" RenderOptions.BitmapInterpolationMode="None"/>
  </Grid>
  <Grid Grid.Row="1" ColumnDefinitions="*,420" ColumnSpacing="18">
     <ScrollViewer Classes="settingsScroll" HorizontalScrollBarVisibility="Disabled" Margin="0">
      <StackPanel Margin="0,0,8,12">
       <Border Classes="card">
      <StackPanel Spacing="8">
       <TextBlock Text="Picture proportions"/>
       <ComboBox Name="AspectCombo" HorizontalAlignment="Stretch">
        <ComboBoxItem Content="4:3 · original proportions"/>
        <ComboBoxItem Content="Stretch · fill monitor"/>
       </ComboBox>
       <CheckBox Name="FillScreenCheckBox" Content="Borderless picture"/>
       <TextBlock Text="Stretch + borderless picture covers the complete monitor. With 4:3, black bars remain outside the picture. Borderless mode also removes curvature." Classes="hint"/>
       <CheckBox Name="CrtCheckBox" Content="Enable CRT effects"/>
       <StackPanel Name="EffectsPanel" Spacing="5">
        <Grid ColumnDefinitions="150,*,42" ColumnSpacing="10">
 <TextBlock Text="Screen curvature" VerticalAlignment="Center"/>
 <Slider Name="CurvatureSlider" Grid.Column="1" Minimum="0" Maximum="100" MinHeight="52" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Screen curvature"/>
 <TextBlock Name="CurvatureLabel" Grid.Column="2" Classes="hint" VerticalAlignment="Center" TextAlignment="Right"/>
</Grid><Grid ColumnDefinitions="150,*,42" ColumnSpacing="10">
 <TextBlock Text="Scanline strength" VerticalAlignment="Center"/>
 <Slider Name="ScanlineStrengthSlider" Grid.Column="1" Minimum="0" Maximum="100" MinHeight="52" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Scanline strength"/>
 <TextBlock Name="ScanlineStrengthLabel" Grid.Column="2" Classes="hint" VerticalAlignment="Center" TextAlignment="Right"/>
</Grid><Grid ColumnDefinitions="150,*,42" ColumnSpacing="10">
 <TextBlock Text="Phosphor mask" VerticalAlignment="Center"/>
 <Slider Name="MaskStrengthSlider" Grid.Column="1" Minimum="0" Maximum="100" MinHeight="52" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Phosphor mask"/>
 <TextBlock Name="MaskStrengthLabel" Grid.Column="2" Classes="hint" VerticalAlignment="Center" TextAlignment="Right"/>
</Grid><Grid ColumnDefinitions="150,*,42" ColumnSpacing="10">
 <TextBlock Text="Horizontal softness" VerticalAlignment="Center"/>
 <Slider Name="SoftnessSlider" Grid.Column="1" Minimum="0" Maximum="100" MinHeight="52" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Horizontal softness"/>
 <TextBlock Name="SoftnessLabel" Grid.Column="2" Classes="hint" VerticalAlignment="Center" TextAlignment="Right"/>
</Grid><Grid ColumnDefinitions="150,*,42" ColumnSpacing="10">
 <TextBlock Text="Phosphor glow" VerticalAlignment="Center"/>
 <Slider Name="GlowSlider" Grid.Column="1" Minimum="0" Maximum="100" MinHeight="52" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Phosphor glow"/>
 <TextBlock Name="GlowLabel" Grid.Column="2" Classes="hint" VerticalAlignment="Center" TextAlignment="Right"/>
</Grid><Grid ColumnDefinitions="150,*,42" ColumnSpacing="10">
 <TextBlock Text="Glow spread" VerticalAlignment="Center"/>
 <Slider Name="GlowSpreadSlider" Grid.Column="1" Minimum="0" Maximum="100" MinHeight="52" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Glow spread"/>
 <TextBlock Name="GlowSpreadLabel" Grid.Column="2" Classes="hint" VerticalAlignment="Center" TextAlignment="Right"/>
</Grid><Grid ColumnDefinitions="150,*,42" ColumnSpacing="10">
 <TextBlock Text="Darkened corners" VerticalAlignment="Center"/>
 <Slider Name="VignetteSlider" Grid.Column="1" Minimum="0" Maximum="100" MinHeight="52" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Darkened corners"/>
 <TextBlock Name="VignetteLabel" Grid.Column="2" Classes="hint" VerticalAlignment="Center" TextAlignment="Right"/>
</Grid><Grid ColumnDefinitions="150,*,42" ColumnSpacing="10">
 <TextBlock Text="Brightness flicker" VerticalAlignment="Center"/>
 <Slider Name="FlickerSlider" Grid.Column="1" Minimum="0" Maximum="100" MinHeight="52" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Brightness flicker"/>
 <TextBlock Name="FlickerLabel" Grid.Column="2" Classes="hint" VerticalAlignment="Center" TextAlignment="Right"/>
</Grid>
        <CheckBox Name="ScanlinesCheckBox" Content="Enable scanlines"/>
       </StackPanel>
       <TextBlock Text="A stable picture by default. Flicker is optional and starts at zero." Classes="hint"/>
      </StackPanel>
     </Border>
      </StackPanel>
     </ScrollViewer>

   <ScrollViewer Classes="settingsScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14" Margin="0,0,10,0">
    <Border Classes="card">
     <StackPanel Spacing="10">
      <Grid ColumnDefinitions="*,Auto,Auto">
       <TextBlock Text="Live preview" FontWeight="SemiBold" VerticalAlignment="Center"/>
       <CheckBox Name="PreviewProgramCheckBox" Grid.Column="1" Content="Animate preview" IsChecked="True" Margin="0,0,8,0"/>
       <Button Name="EnlargePreviewButton" Grid.Column="2" Width="32" Height="32" MinHeight="32" Padding="7"
        Click="EnlargePreview_Click" ToolTip.Tip="Open enlarged live preview · F11 for fullscreen"
        AutomationProperties.Name="Open enlarged live preview">
        <Path Data="{x:Static ui:ButtonIcons.External}" Stroke="#EAF0F3" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/>
       </Button>
      </Grid>
      <Border Background="Black" CornerRadius="6" ClipToBounds="True">
       <local:C64Scene Name="PreviewScene" Height="200" PreviewDetails="True"/>
      </Border>
      <TextBlock Name="PreviewHint" Classes="hint"/>
      <TextBlock Text="Monitor preset" Classes="hint"/>
      <ComboBox Name="PresetCombo" HorizontalAlignment="Stretch">
       <ComboBoxItem Content="Clean pixels · all effects off"/>
       <ComboBoxItem Content="Subtle CRT · stable and clear"/>
       <ComboBoxItem Content="Classic monitor · more texture"/>
       <ComboBoxItem Content="Custom"/>
       <ComboBoxItem Content="Glowing CRT · broad phosphor halo"/>
      </ComboBox>
     </StackPanel>
    </Border>
    <Border Classes="card">
     <StackPanel Spacing="8">
      <TextBlock Text="Transitions &amp; display" FontWeight="SemiBold"/>
      <CheckBox Name="PowerTransitionCheckBox" Content="CRT power-off / on between scenes"/>
      <Button Name="PowerPreviewButton" Content="Test CRT power effect" Click="PowerPreview_Click" HorizontalAlignment="Left"/>
      <CheckBox Name="FpsCheckBox" Content="Show frame rate on startup"/>
      <TextBlock Text="Programs, runtime and texts are configured in the companion app." Classes="hint"/>
     </StackPanel>
    </Border>
   </StackPanel></ScrollViewer>
  </Grid>
  <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,18,0,0">
   <Button Classes="icon" Content="Reset" Click="Reset_Click" ui:ButtonIcons.Icon="{x:Static ui:ButtonIcons.Reset}"/>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
    <TextBlock Name="VersionLabel" Classes="hint"/>
    <TextBlock Name="StatusLabel" Foreground="#FFCC80" FontSize="11" TextWrapping="Wrap"/>
   </StackPanel>
   <Button Grid.Column="2" Classes="icon" Content="About" Click="About_Click" Margin="0,0,10,0" ui:ButtonIcons.Icon="{x:Static ui:ButtonIcons.Info}"/>
   <Button Grid.Column="3" Classes="icon" Content="Cancel" Click="Cancel_Click" IsCancel="True" Margin="0,0,10,0" ui:ButtonIcons.Icon="{x:Static ui:ButtonIcons.Close}"/>
   <Button Grid.Column="4" Classes="icon primary" Content="Save" Click="Save_Click" IsDefault="True" ui:ButtonIcons.Icon="{x:Static ui:ButtonIcons.Save}"/>
  </Grid>
 </Grid>
</Window>